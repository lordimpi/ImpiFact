{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/app/browser",
      "isSinglePageApplication": true,
      "url": ["http://localhost/login"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports/mobile"
    }
  }
}
