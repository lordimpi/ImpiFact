/*
 * Compilación de la librería core con ng-packagr. Aquí @impifact/api apunta a su versión construida en dist/
 * (ng build api primero, ver el script build:libs), porque ng-packagr no compila código fuente de otra librería.
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    "paths": {
      "@impifact/api": ["../../dist/api"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
