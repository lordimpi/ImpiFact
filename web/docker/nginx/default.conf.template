# Servidor del panel (Dockerfile.web): archivos estáticos del build de Angular. Al arrancar, la imagen de nginx llena
# esta plantilla con las variables IMPIFACT_* (las prepara 15-impifact-config.envsh) y la deja en
# /etc/nginx/conf.d/default.conf.

# Registro de accesos con la ruta que pidió el navegador (no la de index.html después de la redirección interna), sin
# la consulta ni el Referer: el enlace para restablecer la contraseña lleva el token en la consulta
# (/restablecer?token=...) y no debe quedar escrito en ningún registro.
map $request_uri $impifact_log_path {
    "~^(?<impifact_path>[^?]*)" $impifact_path;
    default "-";
}
log_format impifact '$remote_addr [$time_local] "$request_method $impifact_log_path $server_protocol" $status $body_bytes_sent $request_time';

# index.html con el nonce de la CSP. Lo arma este servidor interno, que solo escucha en el loopback del contenedor: el
# servidor público le pasa el nonce de su respuesta ($request_id) en X-Impifact-Csp-Nonce y sub_filter cambia por él el
# marcador IMPIFACT_CSP_NONCE (ngCspNonce de <app-root> y los nonce que Angular puso en los scripts y estilos en línea).
# Pasar por un proxy es lo que permite responder siempre 200: nginx contesta 304 a «If-None-Match: *» en cualquier
# archivo propio aunque no tenga ETag, y la respuesta de un proxy sin caché nunca se convierte en 304.
server {
    listen 127.0.0.1:8081;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log off;

    location = /index.html {
        etag off;
        if_modified_since off;
        sub_filter_once off;
        sub_filter 'IMPIFACT_CSP_NONCE' '$http_x_impifact_csp_nonce';
    }

    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log impifact;

    gzip on;
    gzip_min_length 1024;
    gzip_types application/javascript text/css application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # Configuración del panel en tiempo de ejecución (RuntimeConfig de @impifact/core): sale de las variables del
    # contenedor, así la misma imagen sirve para cualquier ambiente sin volver a compilar.
    location = /config.json {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"apiBaseUrl":"${IMPIFACT_API_BASE_URL}","inactivity":{"warnMinutes":${IMPIFACT_INACTIVITY_WARN_MINUTES},"logoutMinutes":${IMPIFACT_INACTIVITY_LOGOUT_MINUTES}},"features":{}}';
    }

    # Prueba de vida de la imagen (HEALTHCHECK de Dockerfile.web y sondas del orquestador), fuera del registro de
    # accesos para no llenarlo.
    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 'Healthy';
    }

    # index.html (también por las rutas del panel, que llegan aquí por la redirección interna de «location /») lleva el
    # nonce de la CSP de esta respuesta, $request_id, el mismo valor del encabezado; lo pone el servidor interno de
    # arriba. Un nonce no se reutiliza nunca: index.html no se guarda en ninguna caché (no-store) ni se revalida (sin
    # ETag, Last-Modified ni encabezados condicionales hacia el servidor interno), porque un 304 juntaría el cuerpo viejo
    # con el nonce nuevo del encabezado.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        proxy_pass http://127.0.0.1:8081/index.html;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Impifact-Csp-Nonce $request_id;
        proxy_set_header If-None-Match "";
        proxy_set_header If-Match "";
        proxy_set_header If-Modified-Since "";
        proxy_set_header If-Unmodified-Since "";
        proxy_set_header Range "";
        proxy_hide_header ETag;
        proxy_hide_header Last-Modified;
    }

    # Archivos con el hash del contenido en el nombre (main-4EHFUUSO.js, chunk-D-0VbNMD.js, styles-RRKL3FZL.css y
    # media/): una versión nueva cambia el nombre, así que se guardan un año sin volver a preguntar.
    location ~ "^/(?:main|chunk|polyfills|styles|worker)-[A-Za-z0-9_-]{8}\.(?:js|css)$" {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /media/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # El panel llama al Api en IMPIFACT_API_BASE_URL. Si está vacía (mismo origen), un proxy o ingress lleva /api/ al
    # Api antes de llegar aquí; este servidor nunca responde index.html por una ruta del Api.
    location ^~ /api/ {
        return 404;
    }

    # Otros archivos (los textos de i18n, el favicon): su nombre no cambia entre versiones, se revalidan siempre. Un
    # archivo que no existe es un 404, no la página del panel.
    location ~ "\.[A-Za-z0-9]+$" {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Rutas del panel (/login, /documentos/...): todas sirven index.html y el router de Angular las resuelve.
    location / {
        try_files $uri /index.html;
    }
}
