# Encabezados de seguridad de todas las respuestas del panel (los incluye default.conf en el servidor y en cada
# location que agrega encabezados propios: en nginx, un add_header en una location anula los heredados).
#
# Content-Security-Policy, probada con el panel compilado en un navegador (e2e/served-panel.spec.ts):
#   script-src y style-src  solo los archivos del panel y lo que lleve el nonce de esta respuesta ($request_id: 128
#                bits al azar, distinto en cada solicitud). En index.html, nginx pone ese mismo valor en el atributo
#                ngCspNonce de <app-root> y en los nonce de los scripts y estilos en línea (default.conf, sub_filter);
#                Angular y Optimus UI lo copian en cada <style> que agregan. Sin 'unsafe-inline'.
#   connect-src  el propio origen (config.json y los textos) y el del Api (IMPIFACT_API_ORIGIN).
#   img-src      data: y blob: para las imágenes que arma el navegador (íconos en CSS, archivos elegidos).
#   frame-src    blob: para la vista previa del PDF, que se muestra en un iframe con el PDF que devolvió el Api.
#   frame-ancestors 'none' (y X-Frame-Options DENY para navegadores viejos): nadie puede incrustar el panel.
# Referrer-Policy no-referrer: el panel no necesita mandar el Referer a nadie y el enlace para restablecer la
# contraseña lleva el token en la consulta (/restablecer?token=...); con no-referrer ni el Api ni otro sitio lo reciben.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'nonce-$request_id'; style-src 'self' 'nonce-$request_id'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${IMPIFACT_API_ORIGIN}; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "no-referrer" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
