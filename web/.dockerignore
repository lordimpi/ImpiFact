dist/
out-tsc/
.angular/
coverage/
playwright-report/
test-results/
blob-report/
.lighthouseci/
lighthouse-reports/
e2e/

**/.env
**/.env.*
**/secrets/
**/.local/
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.crt
**/*.cer

**/.codegraph/
**/.claude/
**/.idea/
**/.vscode/
