# syntax=docker/dockerfile:1
# Imagen de la API (Arquitectura detallada, sección 14). El contexto es la carpeta backend/, desde la raíz del
# repositorio:
#   docker build -f Dockerfile.api -t impifact-api backend
# Sin secretos en ninguna capa: la cadena de conexión, la llave de JWT y la llave maestra entran al arrancar por
# variables de entorno o archivos montados (deploy/docker-compose.yml, perfil «app»).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
# La caché de NuGet queda fuera de la imagen y acelera las compilaciones siguientes.
RUN --mount=type=cache,id=impifact-nuget,target=/root/.nuget/packages \
    dotnet publish src/ImpiFact.Api/ImpiFact.Api.csproj -c Release -o /app -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
# /data guarda los archivos (Storage:Local:Root) y los certificados cifrados (Secrets:LocalAesGcm:CertificateDirectory)
# cuando no se usa la nube. Es del usuario sin privilegios «app» de la imagen base, así un volumen nuevo hereda el dueño.
RUN mkdir -p /data/storage /data/certificates && chown -R "$APP_UID:$APP_UID" /data
COPY --from=build /app .
USER $APP_UID
# Kestrel escucha en el 8080 (ASPNETCORE_HTTP_PORTS de la imagen base); HTTPS lo termina el proxy o el ingress.
ENV Storage__Local__Root=/data/storage \
    Secrets__LocalAesGcm__CertificateDirectory=/data/certificates
EXPOSE 8080
# Prueba de vida sin instalar curl: bash abre la conexión y revisa que /health/live responda 200. Si se cambia el
# puerto (ASPNETCORE_HTTP_PORTS), hay que cambiarlo también aquí o en la prueba de salud del orquestador.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080 && printf 'GET /health/live HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["dotnet", "ImpiFact.Api.dll"]
