<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!--
    Worker: proceso aparte, con la misma imagen base que la API y otro punto de entrada, que corre los servicios en
    segundo plano (Arquitectura detallada, sección 8). Por ahora, el procesador de la bandeja de salida (outbox).
    Solo compone: la lógica vive en Application e Infrastructure.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Kestrel para las pruebas de salud por HTTP (/health/live y /health/ready en WorkerHealth:Port), las que usan las
      sondas de Docker, Kubernetes y Container Apps. Viene con el runtime de ASP.NET Core, el de la imagen de la API, que
      también trae Microsoft.Extensions.Hosting.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ImpiFact.Application\ImpiFact.Application.csproj" />
    <ProjectReference Include="..\ImpiFact.Infrastructure\ImpiFact.Infrastructure.csproj" />
    <ProjectReference Include="..\ImpiFact.Infrastructure.MySql\ImpiFact.Infrastructure.MySql.csproj" />
    <ProjectReference Include="..\ImpiFact.Infrastructure.Postgres\ImpiFact.Infrastructure.Postgres.csproj" />
  </ItemGroup>
</Project>
