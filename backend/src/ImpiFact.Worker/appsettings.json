{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Postgres"
  },
  "Dian": {
    "HabilitacionUrl": "https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc",
    "ProduccionUrl": "https://vpfe.dian.gov.co/WcfDianCustomerServices.svc",
    "HabilitacionQrUrl": "https://catalogo-vpfe-hab.dian.gov.co/document/searchqr?documentkey=",
    "ProduccionQrUrl": "https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=",
    "TimeoutSeconds": 60
  },
  "Secrets": {
    "Provider": "LocalAesGcm"
  },
  "Storage": {
    "Provider": "Local"
  },
  "Jwt": {
    "Issuer": "impifact",
    "Audience": "impifact-web",
    "AccessMinutes": 15,
    "RefreshDays": 14
  },
  "ApiKey": {
    "Prefix": "apk_"
  },
  "Outbox": {
    "PollSeconds": 2,
    "LockMinutes": 5,
    "MaxAttempts": 5,
    "BatchSize": 20,
    "HandlerTimeoutSeconds": 270
  },
  "ScheduledJobs": {
    "RunAtUtc": "08:00",
    "RunOnStartup": true,
    "OutboxRetentionDays": 30,
    "DeleteBatchSize": 1000
  },
  "Resilience": {
    "Retries": 3,
    "BaseDelaySeconds": 2,
    "BreakerFailures": 5,
    "BreakerSeconds": 30,
    "BreakDurationSeconds": 30,
    "TotalSeconds": 120
  },
  "Pdf": {
    "GotenbergUrl": "http://127.0.0.1:3000",
    "TimeoutSeconds": 60
  },
  "Email": {
    "Port": 587,
    "Encryption": "starttls",
    "FromName": "ImpiFact",
    "TimeoutSeconds": 60
  }
}
