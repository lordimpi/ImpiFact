{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "Dian": {
    "HabilitacionUrl": "https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc",
    "ProduccionUrl": "https://vpfe.dian.gov.co/WcfDianCustomerServices.svc",
    "HabilitacionQrUrl": "https://catalogo-vpfe-hab.dian.gov.co/document/searchqr?documentkey=",
    "ProduccionQrUrl": "https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=",
    "TimeoutSeconds": 60
  },
  "Secrets": {
    "Provider": "LocalAesGcm"
  },
  "Storage": {
    "Provider": "Local"
  },
  "Jwt": {
    "Issuer": "impifact",
    "Audience": "impifact-web",
    "AccessMinutes": 15,
    "RefreshDays": 14
  },
  "ApiKey": {
    "Prefix": "apk_"
  },
  "Cors": {
    "Origins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Pdf": {
    "GotenbergUrl": "http://127.0.0.1:3000",
    "TimeoutSeconds": 15
  },
  "RateLimit": {
    "PermitPerMinutePerKey": 120,
    "PermitPerMinutePerIp": 300,
    "LoginPerMinute": 10
  }
}
