<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- API HTTP: endpoints sin lógica que delegan en los casos de uso de Application. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!--
      JwtBearer trae Microsoft.IdentityModel 8.19; Infrastructure usa 8.23. Se fija aquí la misma versión para
      que todos los paquetes de Microsoft.IdentityModel queden alineados (mezclarlos falla en tiempo de ejecución).
    -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <!--
    Ejemplos de emisión que Scalar muestra precargados: se incrustan al compilar desde los casos golden
    (tests/golden, solicitudes que la DIAN aceptó), así nunca se desalinean de ellos. Ver OpenApi/OpenApiExamples.cs.
  -->
  <ItemGroup>
    <GoldenExample Include="invoice/single-line-iva19;invoice/two-lines-discounts-iva19;invoice/mixed-iva-19-5-0;invoice/final-consumer" />
    <GoldenExample Include="credit-note/partial-return-with-reference;credit-note/without-reference-invoice-period" />
    <GoldenExample Include="debit-note/price-adjustment-with-reference" />
    <GoldenExample Update="@(GoldenExample)" LogicalName="golden/%(Identity)/input.json" />
    <EmbeddedResource Include="@(GoldenExample->'..\..\tests\golden\%(Identity)\input.json')" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ImpiFact.Application\ImpiFact.Application.csproj" />
    <ProjectReference Include="..\ImpiFact.Infrastructure\ImpiFact.Infrastructure.csproj" />
    <ProjectReference Include="..\ImpiFact.Infrastructure.Postgres\ImpiFact.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\ImpiFact.Infrastructure.SqlServer\ImpiFact.Infrastructure.SqlServer.csproj" />
  </ItemGroup>
</Project>
