<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pruebas de contrato: la colección Postman oficial de ApiDian (copia limpia en collection/) se reproduce contra la
    API real, con PostgreSQL en Docker (Testcontainers) y la DIAN falsa. Reutiliza los hosts de prueba de
    ImpiFact.Integration.Tests (API, Worker, DIAN falsa y certificados de prueba) en vez de copiarlos.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ImpiFact.Api\ImpiFact.Api.csproj" />
    <ProjectReference Include="..\ImpiFact.Integration.Tests\ImpiFact.Integration.Tests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="collection\apidian-v2.1.postman_collection.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>
