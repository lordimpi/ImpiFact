# syntax=docker/dockerfile:1
# Imagen del Worker (Arquitectura detallada, secciones 8 y 14): la misma base que la API (el runtime de ASP.NET Core,
# que necesita su Kestrel de las pruebas de salud) y otro punto de entrada. El contexto es la carpeta backend/, desde la
# raíz del repositorio:
#   docker build -f Dockerfile.worker -t impifact-worker backend
# Sin secretos en ninguna capa: entran al arrancar por variables de entorno o archivos montados.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=impifact-nuget,target=/root/.nuget/packages \
    dotnet publish src/ImpiFact.Worker/ImpiFact.Worker.csproj -c Release -o /app -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
# Las mismas carpetas que la API: el Worker lee y escribe los mismos archivos y certificados.
RUN mkdir -p /data/storage /data/certificates && chown -R "$APP_UID:$APP_UID" /data
COPY --from=build /app .
USER $APP_UID
# Las pruebas de salud escuchan en todas las interfaces del contenedor (por defecto solo en loopback): la sonda de
# Docker, Kubernetes o Container Apps llega desde fuera. El puerto es WorkerHealth:Port (8091 en su appsettings.json).
# El Worker no sirve la API: se vacía ASPNETCORE_HTTP_PORTS de la imagen base, que no usa.
ENV WorkerHealth__Host=0.0.0.0 \
    ASPNETCORE_HTTP_PORTS= \
    Storage__Local__Root=/data/storage \
    Secrets__LocalAesGcm__CertificateDirectory=/data/certificates
EXPOSE 8091
# Prueba de vida sin instalar curl: bash abre la conexión y revisa que /health/live responda 200. Si se cambia
# WorkerHealth__Port, hay que cambiarlo también aquí o en la prueba de salud del orquestador.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8091 && printf 'GET /health/live HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["dotnet", "ImpiFact.Worker.dll"]
